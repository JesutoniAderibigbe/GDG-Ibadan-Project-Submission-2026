{
  "entities": {
    "Submission": {
      "title": "Submission",
      "description": "A hackathon project submission",
      "type": "object",
      "properties": {
        "teamName": { "type": "string" },
        "email": { "type": "string", "description": "Team contact email, used to reach selected teams" },
        "teamMembers": { "type": "string" },
        "projectTitle": { "type": "string" },
        "projectLink": { "type": "string" },
        "githubLink": { "type": "string" },
        "whatBuilt": { "type": "string", "maxLength": 2000 },
        "whyBuilt": { "type": "string", "maxLength": 2000 },
        "aiToolsUsed": { "type": "string" },
        "mediaUrl": { "type": "string", "description": "Optional screenshot/video URL, uploaded to Cloudinary" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["teamName", "email", "teamMembers", "projectTitle", "projectLink", "whatBuilt", "whyBuilt", "aiToolsUsed", "createdAt"]
    },
    "Rating": {
      "title": "Rating",
      "description": "A judge's rating for a submission",
      "type": "object",
      "properties": {
        "judgeId": { "type": "string" },
        "score": { "type": "number", "minimum": 1, "maximum": 100 },
        "comment": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["judgeId", "score", "comment", "updatedAt"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Collection of all hackathon submissions."
    },
    "/submissions/{submissionId}/ratings/{judgeId}": {
      "schema": { "$ref": "#/entities/Rating" },
      "description": "Ratings subcollection for each submission by judges."
    }
  }
}
