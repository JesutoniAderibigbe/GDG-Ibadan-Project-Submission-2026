rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['teamName', 'email', 'teamMembers', 'projectTitle', 'projectLink', 'whatBuilt', 'whyBuilt', 'aiToolsUsed', 'createdAt'])
        && data.keys().size() == 9
          + (('githubLink' in data) ? 1 : 0)
          + (('mediaUrl' in data) ? 1 : 0)
          + (('mediaType' in data) ? 1 : 0)
        && data.teamName is string && data.teamName.size() > 0 && data.teamName.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 320
          && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.teamMembers is string && data.teamMembers.size() > 0 && data.teamMembers.size() <= 1000
        && data.projectTitle is string && data.projectTitle.size() > 0 && data.projectTitle.size() <= 150
        && data.projectLink is string && data.projectLink.size() > 0 && data.projectLink.size() <= 500
        && (!('githubLink' in data) || (data.githubLink is string && data.githubLink.size() > 0 && data.githubLink.size() <= 500))
        && data.whatBuilt is string && data.whatBuilt.size() > 0 && data.whatBuilt.size() <= 3000
        && data.whyBuilt is string && data.whyBuilt.size() > 0 && data.whyBuilt.size() <= 3000
        && data.aiToolsUsed is string && data.aiToolsUsed.size() > 0 && data.aiToolsUsed.size() <= 1000
        // mediaUrl and mediaType are optional but must be present/absent together
        && (('mediaUrl' in data) == ('mediaType' in data))
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() > 0 && data.mediaUrl.size() <= 1000))
        && (!('mediaType' in data) || (data.mediaType is string && (data.mediaType == 'image' || data.mediaType == 'video')))
        && data.createdAt == request.time;
    }

    function isValidRating(data) {
       // Keep this judgeId allowlist in sync with VALID_JUDGES in src/lib/judges.ts
       return data.keys().hasAll(['judgeId', 'score', 'comment', 'updatedAt'])
        && data.keys().size() == 4
        && data.judgeId in ['jesutoni', 'abidemi', 'josh']
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.comment is string && data.comment.size() >= 0 && data.comment.size() <= 2000
        && data.updatedAt == request.time;
    }

    match /submissions/{submissionId} {
      allow create: if isValidSubmission(request.resource.data);
      allow read: if true;
      allow update, delete: if false;

      match /ratings/{judgeId} {
        allow read: if true;
        allow create: if isValidRating(request.resource.data) && judgeId == request.resource.data.judgeId;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'comment', 'updatedAt', 'judgeId'])
                      && request.resource.data.judgeId == resource.data.judgeId
                      && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100
                      && request.resource.data.comment is string && request.resource.data.comment.size() >= 0 && request.resource.data.comment.size() <= 2000
                      && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /{path=**}/ratings/{judgeId} {
      allow read: if true;
    }

    // ---- Feedback forms (attendees + sponsors) ----
    // Anyone may create a well-formed response; only organisers can read them.
    // Keep the field names/options/limits in sync with src/lib/feedback.ts.

    // Only the dedicated feedback-admin account (email/password) may read responses.
    // Matched by uid, not email: email/password sign-up is open on this project, so
    // anyone can register an account, but nobody else can ever have this uid.
    function isFeedbackAdmin() {
      return request.auth != null
        && request.auth.uid in ['6vkC2F2VDSN1k2zJMZ06HykUFPj2'];
    }

    function isInt(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function optInt(d, k, lo, hi) { return !(k in d) || isInt(d[k], lo, hi); }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() > 0 && d[k].size() <= max); }
    function optEnum(d, k, opts) { return !(k in d) || (d[k] is string && d[k] in opts); }
    function optList(d, k, opts) {
      return !(k in d) || (d[k] is list && d[k].size() > 0 && d[k].size() <= opts.size() && d[k].hasOnly(opts));
    }
    function optEmail(d, required) {
      return (!('email' in d) && !required)
        || ('email' in d && d.email is string && d.email.size() > 0 && d.email.size() <= 320
            && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'));
    }

    function isValidAttendeeFeedback(d) {
      return d.keys().hasAll(['overall', 'nps', 'venue', 'sessions', 'organisation', 'food', 'networking', 'createdAt'])
        && d.keys().hasOnly(['overall', 'nps', 'venue', 'sessions', 'organisation', 'food', 'networking',
                             'halls', 'favourite', 'enjoyedMost', 'improve', 'tookQuiz', 'quizRating',
                             'sawShowcase', 'showcaseRating', 'topics', 'role', 'heardFrom', 'email', 'createdAt'])
        && isInt(d.overall, 1, 5) && isInt(d.nps, 0, 10)
        && isInt(d.venue, 1, 5) && isInt(d.sessions, 1, 5) && isInt(d.organisation, 1, 5)
        && isInt(d.food, 1, 5) && isInt(d.networking, 1, 5)
        && optList(d, 'halls', ['Hall 1', 'Hall 2', 'Hall 3', 'Hall 4'])
        && optStr(d, 'favourite', 300) && optStr(d, 'enjoyedMost', 1500) && optStr(d, 'improve', 1500)
        && optEnum(d, 'tookQuiz', ['Yes', 'No']) && optInt(d, 'quizRating', 1, 5)
        && optEnum(d, 'sawShowcase', ['Yes', 'No']) && optInt(d, 'showcaseRating', 1, 5)
        && optList(d, 'topics', ['AI', 'Web', 'Mobile', 'Cloud', 'Design', 'Career', 'Other'])
        && optEnum(d, 'role', ['Student', 'Developer', 'Designer', 'Other'])
        && optStr(d, 'heardFrom', 200)
        && optEmail(d, false)
        && d.createdAt == request.time;
    }

    function isValidSponsorFeedback(d) {
      return d.keys().hasAll(['company', 'contactName', 'email', 'overall', 'communication', 'booth', 'visibility',
                              'audience', 'talent', 'value', 'sponsorAgain', 'createdAt'])
        && d.keys().hasOnly(['company', 'contactName', 'email', 'overall', 'communication', 'booth', 'visibility',
                             'audience', 'talent', 'value', 'goalLeads', 'goalHiring', 'goalAwareness',
                             'goalProductFeedback', 'conversations', 'worked', 'improve', 'sponsorAgain',
                             'nextPackage', 'createdAt'])
        && d.company is string && d.company.size() > 0 && d.company.size() <= 150
        && d.contactName is string && d.contactName.size() > 0 && d.contactName.size() <= 150
        && optEmail(d, true)
        && isInt(d.overall, 1, 5) && isInt(d.communication, 1, 5) && isInt(d.booth, 1, 5)
        && isInt(d.visibility, 1, 5) && isInt(d.audience, 1, 5) && isInt(d.talent, 1, 5) && isInt(d.value, 1, 5)
        && optEnum(d, 'goalLeads', ['Yes', 'Partly', 'No']) && optEnum(d, 'goalHiring', ['Yes', 'Partly', 'No'])
        && optEnum(d, 'goalAwareness', ['Yes', 'Partly', 'No']) && optEnum(d, 'goalProductFeedback', ['Yes', 'Partly', 'No'])
        && optEnum(d, 'conversations', ['0-10', '11-30', '31-60', '60+'])
        && optStr(d, 'worked', 1500) && optStr(d, 'improve', 1500)
        && d.sponsorAgain in ['Definitely', 'Probably', 'Unsure', 'No']
        && optStr(d, 'nextPackage', 500)
        && d.createdAt == request.time;
    }

    match /attendeeFeedback/{id} {
      allow create: if isValidAttendeeFeedback(request.resource.data);
      allow read: if isFeedbackAdmin();
      allow update, delete: if false;
    }

    match /sponsorFeedback/{id} {
      allow create: if isValidSponsorFeedback(request.resource.data);
      allow read: if isFeedbackAdmin();
      allow update, delete: if false;
    }
  }
}
